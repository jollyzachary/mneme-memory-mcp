# Mneme project/env-scoped memory example
#
# Use this with:
#   ./scripts/install.sh --profile project --profile-confirmed --env-file .env
#
# The installer will add MNEME_HOME automatically when needed.
# By default it uses:
#   ~/.local/share/mneme-memory-mcp/projects/<repo-name>
#
# To force memory into this repo checkout instead, uncomment:
# MNEME_HOME=.mneme

# Optional local PostgreSQL + pgContext + pgGraph retrieval plane.
# Keep `sqlite` until the staged copy is complete; use `dual` before `postgres`.
# MNEME_RETRIEVAL_BACKEND=sqlite
# MNEME_POSTGRES_HOST=127.0.0.1
# MNEME_POSTGRES_PORT=55433
# MNEME_POSTGRES_DATABASE=mneme
# MNEME_POSTGRES_USER=mneme_app
# MNEME_POSTGRES_PASSWORD_FILE=~/.local/share/mneme-memory-mcp/postgres/secrets/app_password
# MNEME_POSTGRES_REQUIRED=0
